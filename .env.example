# Public website URL used for metadata, sitemap, and robots.txt.
NEXT_PUBLIC_SITE_URL=https://flowmint.ai

# Contact page email link. Leave blank until you have a public inbox.
NEXT_PUBLIC_CONTACT_EMAIL=

# Real checkout destination for LinkedIn Content Automation (no price is assumed).
NEXT_PUBLIC_PRODUCT_CHECKOUT_URL=

# Mailchimp credentials (server-side only; never prefix these with NEXT_PUBLIC_).
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SERVER_PREFIX=

# Add an analytics provider here when selected. No tracking is enabled by default.
# NEXT_PUBLIC_ANALYTICS_ID=
